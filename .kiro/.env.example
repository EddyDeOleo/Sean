# Template for .kiro/.env, the backend's optional local configuration (backend/app/core/env.py).
# Copy this file to .kiro/.env and fill in only what you use. .kiro/.env is ignored by Git and by Kiro: never commit it.
# Only the names below are read. A value already set in the process environment wins. Values are never logged.
# The two keys are read by the backend only. Never put them in the frontend build or in a VITE_ variable.

# Optional. Groq API key, used only to word the AI Engineering Advisor answer. Without it, Sean works without AI.
SEAN_GROQ_API_KEY=

# Optional. GitHub token, used only for higher GitHub REST API limits on public pull request and issue metadata.
SEAN_GITHUB_TOKEN=

# Not secrets. The exact web origins that may use the local agent after pairing (the Netlify site), comma-separated, for
# example the site's https://<name>.netlify.app address. Empty means none. scripts\start_agent.ps1 -AllowedOrigin sets it too.
SEAN_ALLOWED_ORIGINS=

# Not secrets. Exact loopback browser origins. Empty means the Vite dev server (http://127.0.0.1:5173 and
# http://localhost:5173); "none" means no loopback browser origin (scripts\start_agent.ps1 sets "none").
SEAN_LOOPBACK_ORIGINS=
